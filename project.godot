; Engine configuration file.
; Permaculture terrain MVP (issue #2). Godot 4.x, GDScript only.

config_version=5

[application]

config/name="Permaculture — Terrain MVP"
config/description="Seeded Sonoran heightmap mesh + D8 water flow MVP (issue #2)."
run/main_scene="res://scenes/terrain.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; Terrain viewer is landscape-first; sensor_landscape (4) lets the device use
; either landscape rotation. Shared setting, no per-platform fork.
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=false
; Touch is handled natively in scripts/main.gd (tap = place, one-finger drag
; = orbit, two-finger pinch = zoom). Emulation stays off so a tap cannot
; double-fire as both a touch and a mouse click. Desktop mouse path unchanged.

[rendering]

renderer/rendering_method="forward_plus"
; Mobile renderer for all handheld exports (issues #8 Android, #9 iOS).
; Desktop keeps Forward Plus. Packaging-only override, no gameplay code change.
; NOTE: Android QA (#15) verified on gl_compatibility; iOS requires "mobile".
; Union keeps "mobile" (works on both via Vulkan/Metal); low-end Android
; gl_compatibility fallback is a follow-up if needed.
renderer/rendering_method.mobile="mobile"
; Required for mobile export: importer writes ETC2/ASTC variants used by the
; mobile builds. Packaging-only; desktop imports unchanged.
textures/vram_compression/import_etc2_astc=true
